# Stellar Skills environment variables.
#
# Local dev needs none of these — `pnpm dev` works with all defaults.
# To override locally, copy this file to `.env.local` (gitignored) and
# uncomment the values you want to set. Production env values live in
# the Vercel project settings, not here.

# -----------------------------------------------------------------------------
# Upstream skill content
# -----------------------------------------------------------------------------

# Git ref (branch, tag, or 40-char commit SHA) of stellar/stellar-dev-skill
# to fetch at build time. Used by scripts/fetch-skills.mjs and threaded
# through to per-card "view source" links in src/app/page.tsx.
#
# Default: "main". For production deploys, pin to a specific commit SHA
# you've reviewed so the site cannot pick up unreviewed upstream changes.
# See README.md → "Pinning the upstream version" for the workflow.
#
# SKILLS_REF=main

# -----------------------------------------------------------------------------
# Site origin
# -----------------------------------------------------------------------------

# Manual override for the site origin used in absolute URLs (skill paths,
# llms.txt). Resolution order in scripts/generate-llms-txt.mjs and
# src/app/page.tsx:
#   1. SITE_ORIGIN
#   2. VERCEL_PROJECT_PRODUCTION_URL  (auto-set on Vercel)
#   3. VERCEL_URL                     (auto-set on Vercel preview deploys)
#   4. http://localhost:3000          (local default)
#
# SITE_ORIGIN=https://stellarskills.com

# -----------------------------------------------------------------------------
# Analytics
# -----------------------------------------------------------------------------

# Set to "true" to disable Google Tag Manager in production builds. GTM
# is loaded via @next/third-parties in src/app/layout.tsx. In development
# (NODE_ENV !== "production") GTM is always disabled regardless of this
# flag.
#
# NEXT_PUBLIC_DISABLE_GOOGLE_ANALYTICS=true
